{
  "name": "open-news-protocol",
  "version": "0.3.0",
  "description": "Open News Protocol (ONP) reference implementation: sign, verify, retrieve, and aggregate cryptographically provenanced News Objects. Envelope, identifiers, JCS (RFC 8785) canonicalization, Ed25519 + ECDSA-P256 signatures, multi-level validation, domain Trust Anchor resolution (with a provisional EUDI hook), and a consumer-Node aggregator.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "onp": "./dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "example": "npm run build && node dist/examples/fusie-onderzoek.js",
    "bridges": "npm run build && node dist/examples/export-bridges.js",
    "capstone": "npm run build && node dist/examples/end-to-end.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "onp",
    "open-news-protocol",
    "news",
    "provenance",
    "digital-signatures",
    "ed25519",
    "ecdsa-p256",
    "eidas",
    "eudi",
    "json-canonicalization",
    "rfc8785",
    "content-authenticity",
    "sdk"
  ],
  "author": "Open News Protocol Working Group",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheckonNL/open-news-protocol.git",
    "directory": "sdk/reference-impl"
  },
  "homepage": "https://github.com/CheckonNL/open-news-protocol#readme",
  "bugs": "https://github.com/CheckonNL/open-news-protocol/issues",
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "canonicalize": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0"
  }
}